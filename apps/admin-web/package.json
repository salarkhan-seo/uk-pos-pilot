{
  "dependencies": {
    "@uk-pos/db": "workspace:*",
    "@uk-pos/shared-kernel": "workspace:*"
  },
  "description": "Admin web dashboard / back-office for the UK POS pilot (Build-04 Objective 2). Framework-free TypeScript view-models + typed API client wired to apps/api; no browser runtime required.",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "kysely": "^0.28.19",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  },
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "name": "@uk-pos/admin-web",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "types": "./dist/index.d.ts",
  "version": "0.1.0"
}
