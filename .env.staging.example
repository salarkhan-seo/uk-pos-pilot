# UK POS/EPOS SaaS pilot — staging environment template (Neon/Supabase + Render).
#
# Copy to .env.staging and fill in the values. NEVER commit a filled-in copy.
#
# ======== WARNINGS — READ FIRST ========
# - DEMO_SEED_ON_BOOT=true is for STAGING / DEMOS ONLY. It seeds a fixed demo
#   tenant with fixed demo credentials (demo PINs: manager 2468, cashier 1234)
#   and a fixed demo API key. NEVER use it with real customer PII or live
#   card processing, and NEVER use it in production.
# - Staging uses the SIMULATED Stripe Terminal adapter (no network calls, no
#   real card processing). No live card payment can run on this staging stack.
# - Build-13: the API now USES DATABASE_URL when it is set — a real `pg`
#   pool against the cloud Postgres, with pending migrations applied on
#   boot (sslmode=require honoured). PGlite is only used when DATABASE_URL
#   is unset (local/test). A malformed or unreachable DATABASE_URL fails
#   the boot loudly; the API never silently falls back to PGlite.
#
# ======== Cloud Postgres (Neon or Supabase, eu-west-2 London) ========
# Full connection string for the staging database. sslmode=require is
# mandatory for Neon/Supabase. Used by the API itself on boot (Build-13),
# by scripts/staging-check.sh and by
# `pnpm --filter @uk-pos/db concurrency:live` (the live G-A-13 check).
DATABASE_URL=postgresql://<user>:<password>@<neon-or-supabase-host>.eu-west-2.<provider>/ukpos_staging?sslmode=require

# ======== API (apps/api/src/main.ts, apps/api/src/database/database.module.ts) ========
# PORT is set automatically by Render; the API reads process.env.PORT
# (default 3000). Only set it locally if you need a fixed port.
PORT=3127
# 'true' seeds the demo tenant/catalogue/session on API boot (idempotent).
# STAGING/DEMO ONLY — see the warnings above.
DEMO_SEED_ON_BOOT=true
# File-backed PGlite directory for LOCAL runs only. Do not set on Render:
# DATABASE_URL wins over PGLITE_DATA_DIR, and a PGlite file would sit on
# an ephemeral filesystem in any case.
# PGLITE_DATA_DIR=<repo-root>/data/pglite

# Webhook secret encryption (apps/api/src/modules/integrations/webhook.service.ts).
# Resolution order: WEBHOOK_ENCRYPTION_KEYS (JSON map key id -> key material)
# + WEBHOOK_ACTIVE_KEY_ID, else the single WEBHOOK_ENCRYPTION_KEY. At least
# one of the two must be set before webhook secrets can be persisted.
# Fill in the Render dashboard (sync: false in render.yaml), never here.
WEBHOOK_ENCRYPTION_KEYS={"k1":"<paste-a-generated-256-bit-key-here>"}
WEBHOOK_ACTIVE_KEY_ID=k1
# WEBHOOK_ENCRYPTION_KEY=<paste-a-generated-256-bit-key-here>

# Platform-operator keyring for POST /v1/webhooks/re-encrypt-secrets
# (apps/api/src/modules/integrations/platform-operator.guard.ts).
# Resolution order: PLATFORM_OPERATOR_KEYS (JSON map operator id -> secret
# key), else the single PLATFORM_OPERATOR_KEY. Without one, the route fails
# closed with 503 PLATFORM_OPERATOR_KEY_NOT_CONFIGURED.
PLATFORM_OPERATOR_KEYS={"operator-1":"<paste-a-generated-operator-secret-here>"}
# PLATFORM_OPERATOR_KEY=<paste-a-generated-operator-secret-here>

# Statutory VAT archive bundle directory (apps/api/src/modules/admin/statutory-archive.ts).
# Default is <repo-root>/data/statutory-archives. On Render free the
# filesystem is ephemeral — archives written here do not survive a restart.
# STATUTORY_ARCHIVE_DIR=<repo-root>/data/statutory-archives

# ======== Register tablet UI (apps/register-app/src/ui/server.ts) ========
# Port the register UI listens on (default 3130). On Render this is set from
# $PORT in render.yaml's start command — do not hardcode it there.
REGISTER_UI_PORT=3130
# API base URL the register calls (default http://localhost:3127).
REGISTER_API_BASE_URL=https://uk-pos-api.onrender.com
# API key the register uses as Bearer <redacted> until a PIN login stores a session
# token. With DEMO_SEED_ON_BOOT=true this defaults to the demo API key.
# REGISTER_API_KEY=<demo-or-real-api-key>
# Actor defaults (default to the demo-seeded ids when DEMO_SEED_ON_BOOT=true).
# REGISTER_TENANT_ID=<tenant-uuid>
# REGISTER_LOCATION_ID=<location-uuid>
# REGISTER_REGISTER_ID=<register-uuid>
# REGISTER_USER_ID=<cashier-user-uuid>
# REGISTER_ROLES=cashier
# Local SQLite file for the offline queue (default: in-memory storage when
# unset). On Render free the filesystem is ephemeral — a file set here is
# lost on redeploy/restart, and the offline queue with it.
# REGISTER_SQLITE_PATH=<repo-root>/data/register.sqlite
# Encrypts the local SQLite file at rest (AES-256-GCM). When unset the file
# is stored UNENCRYPTED and the page shows a warning banner.
# REGISTER_APP_DEVICE_SECRET=<paste-a-generated-device-secret-here>
# Key id for the device cipher (default k1).
# REGISTER_APP_DEVICE_KEY_ID=k1
# Live request timeout in ms (default 15000; apps/register-app/src/api/live-transport.ts:79).
# REGISTER_API_TIMEOUT_MS=15000

# ======== Admin web shell (apps/admin-web/src/ui/server.ts) ========
# Port the admin shell listens on (default 3131). On Render this is set from
# $PORT in render.yaml's start command — do not hardcode it there.
ADMIN_WEB_PORT=3131
# API base URL the admin shell calls. With DEMO_SEED_ON_BOOT=true this
# defaults to http://localhost:3127 locally — set it to the Render API URL.
ADMIN_API_BASE_URL=https://uk-pos-api.onrender.com
# API token for the admin shell. With DEMO_SEED_ON_BOOT=true this defaults
# to the demo API key.
# ADMIN_API_TOKEN=<demo-or-real-api-key>
# Operator identity sent as x-user-id / x-user-roles on live renders.
# With DEMO_SEED_ON_BOOT=true these default to the demo owner (roles: owner).
# ADMIN_USER_ID=<owner-user-uuid>
# ADMIN_USER_ROLES=owner
# Tenant/location the shell operates on (default to the demo-seeded ids
# when DEMO_SEED_ON_BOOT=true).
# ADMIN_TENANT_ID=<tenant-uuid>
# ADMIN_LOCATION_ID=<location-uuid>

# ======== Node ========
NODE_ENV=production
